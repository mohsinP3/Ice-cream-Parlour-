@model IEnumerable<Ice_Cream_Parlour_Eproject.Models.Recipe>
@{
    ViewData["Title"] = "Products";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Product Management</h2>
            <p class="text-muted">Manage ice cream products, recipes and pricing</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Add Product
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search and Sort Form -->
    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="searchString" class="form-control" placeholder="Search by name or category..." value="@ViewData["CurrentFilter"]" />
                <button class="btn btn-outline-secondary" type="submit"><i class="fas fa-search"></i> Search</button>
            </div>
        </div>
        <div class="col-md-4">
            <select name="sortBy" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(ViewData["CurrentSort"] as string) ? "selected" : null)">Sort by Name (A-Z)</option>
                <option value="name_desc" selected="@((ViewData["CurrentSort"] as string) == "name_desc" ? "selected" : null)">Sort by Name (Z-A)</option>
                <option value="category" selected="@((ViewData["CurrentSort"] as string) == "category" ? "selected" : null)">Sort by Category</option>
                <option value="price" selected="@((ViewData["CurrentSort"] as string) == "price" ? "selected" : null)">Sort by Price (Low to High)</option>
                <option value="price_desc" selected="@((ViewData["CurrentSort"] as string) == "price_desc" ? "selected" : null)">Sort by Price (High to Low)</option>
            </select>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-secondary w-100">Clear</a>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th>Price</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @{
                                        // ==== FIX: Sahi Image Path ====
                                        string imageUrl = "";
                                        if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            // Agar path online hai (http se start)
                                            if (item.ImagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                                            {
                                                imageUrl = item.ImagePath;
                                            }
                                            // Agar path ~/ se start hai to hatao
                                            else if (item.ImagePath.StartsWith("~"))
                                            {
                                                imageUrl = item.ImagePath.TrimStart('~');
                                            }
                                            // Agar path / se start nahi hai to / lagao
                                            else if (!item.ImagePath.StartsWith("/"))
                                            {
                                                imageUrl = "/" + item.ImagePath;
                                            }
                                            else
                                            {
                                                imageUrl = item.ImagePath;
                                            }
                                        }
                                    }

                                    @if (!string.IsNullOrEmpty(imageUrl))
                                    {
                                        <img src="@imageUrl" alt="@item.Name"
                                             style="width:50px; height:50px; object-fit:cover; border-radius:8px;"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div style="width:50px; height:50px; background:#f0f0f0; border-radius:8px; display:none; align-items:center; justify-content:center;">
                                            <i class="fas fa-ice-cream text-muted"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="width:50px; height:50px; background:#f0f0f0; border-radius:8px; display:flex; align-items:center; justify-content:center;">
                                            <i class="fas fa-ice-cream text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td><strong>@item.Name</strong></td>
                                <td><span class="badge bg-info">@item.Category</span></td>
                                <td>
                                    @if (item.IsFree)
                                    {
                                        <span class="badge bg-success">Free</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Premium</span>
                                    }
                                </td>
                                <td>
                                    @if (!item.IsFree)
                                    {
                                        <span class="fw-bold">$@item.Price.ToString("0.00")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Free</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this product?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (ViewData["TotalPages"] != null && ((int?)ViewData["TotalPages"] ?? 0) > 1)
    {
        int totalPages = (int)ViewData["TotalPages"]!;
        int currentPage = (int?)ViewData["CurrentPage"] ?? 1;
        <nav aria-label="Product navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(currentPage - 1)" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortBy="@ViewData["CurrentSort"]">Previous</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortBy="@ViewData["CurrentSort"]">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(currentPage + 1)" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortBy="@ViewData["CurrentSort"]">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
