<%- include('../partials/header') %>

<div class="bg-light py-4 border-bottom">
    <div class="container">
        <h2 class="font-playfair fw-bold mb-1">Checkout &amp; Order Confirmation</h2>
        <p class="text-muted mb-0">Provide your shipping details and select payment method</p>
    </div>
</div>

<div class="container py-5">
    <form action="/checkout" method="POST">
        <div class="row g-4">
            <!-- Customer Details Form -->
            <div class="col-lg-7">
                <div class="bg-white rounded-4 shadow-sm border p-4 p-md-5">
                    <h4 class="fw-bold mb-4 text-dark"><i class="fas fa-truck text-primary me-2"></i>Shipping Information</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Full Name *</label>
                            <input type="text" name="customerName" class="form-control rounded-3" value="<%= currentUser ? currentUser.fullName : '' %>" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email Address *</label>
                            <input type="email" name="customerEmail" class="form-control rounded-3" value="<%= currentUser ? currentUser.email : '' %>" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Phone Number *</label>
                            <input type="tel" name="customerPhone" class="form-control rounded-3" placeholder="+1 (555) 000-0000" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Payment Method *</label>
                            <select name="paymentMethod" class="form-select rounded-3">
                                <option value="Cash on Delivery">Cash on Delivery</option>
                                <option value="Credit Card">Credit Card</option>
                                <option value="PayPal">PayPal</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Delivery Address *</label>
                            <textarea name="deliveryAddress" class="form-control rounded-3" rows="3" placeholder="Full street address, apartment, city, state, zip" required><%= currentUser ? currentUser.address : '' %></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Special Instructions / Notes</label>
                            <textarea name="notes" class="form-control rounded-3" rows="2" placeholder="e.g., Leave with doorman or ring doorbell"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Items Summary Sidebar -->
            <div class="col-lg-5">
                <div class="bg-white rounded-4 shadow-sm border p-4">
                    <h5 class="fw-bold border-bottom pb-3 mb-3"><i class="fas fa-ice-cream text-primary me-2"></i>Your Order Items (<%= cartItems.length %>)</h5>
                    <div class="mb-3" style="max-height: 280px; overflow-y: auto;">
                        <% cartItems.forEach(item => { %>
                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center">
                                    <img src="<%= item.imagePath %>" class="rounded-3 me-3" style="width: 50px; height: 50px; object-fit: cover;" alt="<%= item.name %>" />
                                    <div>
                                        <h6 class="fw-bold mb-0"><%= item.name %></h6>
                                        <small class="text-muted"><%= item.quantity %> x $<%= item.price.toFixed(2) %></small>
                                    </div>
                                </div>
                                <span class="fw-bold text-primary">$<%= (item.price * item.quantity).toFixed(2) %></span>
                            </div>
                        <% }); %>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-bold">$<%= subtotal.toFixed(2) %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Delivery</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fs-4 mb-4">
                        <span class="fw-bold">Total Amount</span>
                        <span class="fw-bold text-primary">$<%= subtotal.toFixed(2) %></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 text-white fw-bold shadow-lg" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                        <i class="fas fa-check-circle me-2"></i>Place Order ($<%= subtotal.toFixed(2) %>)
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
