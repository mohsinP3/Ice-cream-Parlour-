<%- include('../partials/header') %>

<div class="bg-primary text-white py-5 text-center" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
    <div class="container py-2">
        <h1 class="display-4 font-playfair fw-bold">Frequently Asked Questions</h1>
        <p class="lead mb-0">Answers to common questions about our products, delivery, and memberships</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="accordion custom-accordion" id="faqAccordion">
                <div class="accordion-item border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button font-playfair fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true">
                            🍦 Is your ice cream made with organic dairy?
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Yes! We source 100% organic, non-pasteurized fresh milk and heavy cream directly from local grass-fed dairy farms without synthetic hormones or antibiotics.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                    <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button collapsed font-playfair fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                            🚚 How does home delivery stay frozen?
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            All delivery orders are packed in eco-friendly insulated thermal coolers with dry-ice packs, ensuring your ice cream arrives rock hard even in summer temperatures.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                    <h2 class="accordion-header" id="headingThree">
                        <button class="accordion-button collapsed font-playfair fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                            👑 What perks do iCREAM members receive?
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Members receive unlimited access to 20+ secret artisan recipes, free delivery on all online orders, priority booking for tasting events, and 15% off celebration ice cream cakes.
                        </div>
                    </div>
                </div>

                <div class="accordion-item border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                    <h2 class="accordion-header" id="headingFour">
                        <button class="accordion-button collapsed font-playfair fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour">
                            🌱 Do you offer vegan or dairy-free options?
                        </button>
                    </h2>
                    <div id="collapseFour" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Absolutely! We craft refreshing fruit sorbets and coconut-cream gelatos that are 100% vegan, dairy-free, and gluten-free.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
