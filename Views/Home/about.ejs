<%- include('../partials/header') %>

<div class="bg-primary text-white py-5 text-center" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
    <div class="container py-3">
        <h1 class="display-4 font-playfair fw-bold">About iCREAM</h1>
        <p class="lead mb-0">Crafting traditional artisan ice cream with passion since 2006</p>
    </div>
</div>

<div class="container py-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <h2 class="font-playfair fw-bold text-dark mb-3">Our Heritage &amp; Philosophy</h2>
            <p class="text-muted lead">Every batch of iCREAM ice cream is created with 100% pure organic dairy from local farms and non-GMO ingredients.</p>
            <p class="text-muted">Founded in 2006 by master gelato makers, our parlour has grown into a beloved destination for families, foodies, and dessert enthusiasts. We slow-churn our ice creams to achieve an extraordinarily dense, velvet-smooth texture without artificial air fluffing or chemical stabilizers.</p>
            <div class="row g-3 mt-3">
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <h3 class="fw-bold text-primary mb-1">100%</h3>
                        <p class="mb-0 text-muted small fw-bold">Organic Farm Fresh Dairy</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <h3 class="fw-bold text-primary mb-1">30+</h3>
                        <p class="mb-0 text-muted small fw-bold">Artisan Flavors Daily</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 text-center">
            <img src="/img/about.jpg" class="img-fluid rounded-4 shadow-lg border border-4 border-white" alt="About iCREAM Parlour" />
        </div>
    </div>
</div>

