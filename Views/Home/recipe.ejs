<%- include('../partials/header') %>

<div class="bg-primary text-white py-5 text-center" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
    <div class="container py-2">
        <h1 class="display-4 font-playfair fw-bold">Artisan Ice Cream Recipes</h1>
        <p class="lead mb-0">Learn to churn gourmet ice creams, sorbets, and gelato from master chefs</p>
    </div>
</div>

<div class="container py-5">
    <%- include('../partials/membership_banner') %>

    <div class="row g-4 mt-2">
        <% recipes.forEach(recipe => { %>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 p-0">
                    <div class="row g-0 h-100">
                        <div class="col-md-5">
                            <img src="<%= recipe.imagePath %>" class="img-fluid h-100 w-100" alt="<%= recipe.name %>" style="object-fit:cover; min-height: 240px;" />
                        </div>
                        <div class="col-md-7">
                            <div class="card-body p-4 d-flex flex-column h-100">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-light text-primary border rounded-pill px-3 py-1"><%= recipe.category %></span>
                                    <% if (recipe.isFree) { %>
                                        <span class="badge bg-success rounded-pill px-3 py-1"><i class="fas fa-unlock me-1"></i>Free Recipe</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="fas fa-lock me-1"></i>Members Only</span>
                                    <% } %>
                                </div>
                                <h4 class="fw-bold card-title mb-2"><%= recipe.name %></h4>
                                
                                <% if (recipe.isFree || (currentUser && currentUser.isPaid)) { %>
                                    <div class="mb-3 flex-grow-1">
                                        <h6 class="fw-bold text-secondary mb-1"><i class="fas fa-mortar-pestle me-1"></i>Ingredients:</h6>
                                        <p class="small text-muted mb-2"><%= recipe.ingredients %></p>
                                        <h6 class="fw-bold text-secondary mb-1"><i class="fas fa-list-ol me-1"></i>Procedure:</h6>
                                        <p class="small text-muted mb-0" style="white-space: pre-line;"><%= recipe.procedure %></p>
                                    </div>
                                <% } else { %>
                                    <div class="p-3 bg-light rounded-3 text-center my-auto border">
                                        <i class="fas fa-crown text-warning fa-2x mb-2"></i>
                                        <h6 class="fw-bold mb-1">Exclusive Member Recipe</h6>
                                        <p class="small text-muted mb-3">Join iCREAM membership to view full ingredients and step-by-step video procedures.</p>
                                        <a href="/account/register" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">Unlock Access</a>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<%- include('../partials/footer') %>
