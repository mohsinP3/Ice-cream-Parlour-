<%- include('../partials/header') %>

<div class="bg-primary text-white py-5 text-center" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
    <div class="container py-2">
        <h1 class="display-4 font-playfair fw-bold">Customer Feedback &amp; Reviews</h1>
        <p class="lead mb-0">See what ice cream lovers say about us or submit your own review!</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <!-- Submit Feedback Form -->
        <div class="col-lg-5">
            <div class="bg-white rounded-4 shadow-sm border p-4 p-md-5">
                <h4 class="font-playfair fw-bold mb-3"><i class="fas fa-edit text-primary me-2"></i>Leave A Review</h4>
                <form action="/feedback" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Name *</label>
                        <input type="text" name="userName" class="form-control rounded-3" value="<%= currentUser ? currentUser.fullName : '' %>" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address *</label>
                        <input type="email" name="email" class="form-control rounded-3" value="<%= currentUser ? currentUser.email : '' %>" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Rating (1 to 5 Stars)</label>
                        <select name="rating" class="form-select rounded-3">
                            <option value="5">★★★★★ 5 Stars (Exceptional)</option>
                            <option value="4">★★★★☆ 4 Stars (Very Good)</option>
                            <option value="3">★★★☆☆ 3 Stars (Good)</option>
                            <option value="2">★★☆☆☆ 2 Stars (Average)</option>
                            <option value="1">★☆☆☆☆ 1 Star (Needs Improvement)</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Your Experience / Feedback *</label>
                        <textarea name="message" class="form-control rounded-3" rows="4" placeholder="Tell us what you liked or how we can improve..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 text-white fw-bold shadow" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                        Submit Review <i class="fas fa-star ms-1"></i>
                    </button>
                </form>
            </div>
        </div>

        <!-- Feedback Reviews List -->
        <div class="col-lg-7">
            <h4 class="font-playfair fw-bold mb-4 text-dark"><i class="fas fa-comments text-primary me-2"></i>Recent Customer Reviews (<%= feedbacks.length %>)</h4>
            <div class="d-flex flex-column gap-3">
                <% feedbacks.forEach(fb => { %>
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width:40px; height:40px; background: linear-gradient(135deg, #F195B2, #62C3E7);">
                                    <%= fb.userName.charAt(0).toUpperCase() %>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0"><%= fb.userName %></h6>
                                    <small class="text-muted"><%= fb.submittedDate %></small>
                                </div>
                            </div>
                            <div class="text-warning fs-6">
                                <% for(let i=0; i<fb.rating; i++) { %>★<% } %>
                                <% for(let i=fb.rating; i<5; i++) { %>☆<% } %>
                            </div>
                        </div>
                        <p class="text-muted mb-0 mt-2">"<%= fb.message %>"</p>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
