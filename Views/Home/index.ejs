<%- include('../partials/header') %>

<!-- HERO CAROUSEL -->
<div class="container-fluid p-0 mb-5">
    <div id="header-carousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active" style="min-height: 450px; background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/carousel-1.jpg') center/cover no-repeat;">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center h-100">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase mb-md-3 tracking-wide" style="letter-spacing: 3px;">Traditional &amp; Delicious</h4>
                        <h1 class="display-3 text-white mb-md-4 font-playfair fw-bold">Traditional Ice Cream Since 2006</h1>
                        <a href="/about" class="btn btn-primary py-md-3 px-md-5 mt-2 rounded-pill shadow" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none; font-weight:600;">Learn More</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item" style="min-height: 450px; background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/carousel-2.jpg') center/cover no-repeat;">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center h-100">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase mb-md-3 tracking-wide" style="letter-spacing: 3px;">Organic &amp; Pure</h4>
                        <h1 class="display-3 text-white mb-md-4 font-playfair fw-bold">Made From Our Own Organic Milk</h1>
                        <a href="/products" class="btn btn-primary py-md-3 px-md-5 mt-2 rounded-pill shadow" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none; font-weight:600;">Explore Flavors</a>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon p-3 bg-dark rounded-circle bg-opacity-50"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#header-carousel" data-bs-slide="next">
            <span class="carousel-control-next-icon p-3 bg-dark rounded-circle bg-opacity-50"></span>
        </button>
    </div>
</div>

<!-- ABOUT PREVIEW -->
<section class="container-fluid py-4">
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="section-title position-relative mb-4 font-playfair fw-bold text-dark">Traditional &amp; Delicious Ice Cream Since 2006</h2>
                <p class="text-muted lead">Crafted daily with organic dairy and pure natural ingredients for an unforgettably rich taste.</p>
            </div>
        </div>
        <div class="row align-items-center g-4 mt-2">
            <div class="col-lg-4">
                <div class="p-4 bg-white rounded-4 shadow-sm border border-light">
                    <h4 class="fw-bold mb-3 text-primary"><i class="fas fa-heart text-danger me-2"></i>Our Story</h4>
                    <p class="text-muted">Founded over two decades ago, iCREAM brings traditional artisan ice cream recipes to life with organic farm milk.</p>
                    <a href="/about" class="btn btn-outline-primary rounded-pill btn-sm fw-bold">Read Full Story →</a>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <img src="/img/about.jpg" class="img-fluid rounded-4 shadow-lg border border-4 border-white" alt="About Ice Cream" style="max-height:380px; object-fit:cover; width:100%;" />
            </div>
            <div class="col-lg-4">
                <div class="p-4 bg-white rounded-4 shadow-sm border border-light">
                    <h4 class="fw-bold mb-3 text-primary"><i class="fas fa-star text-warning me-2"></i>Our Promise</h4>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa fa-check-circle text-success me-2 fs-5"></i>
                        <span>100% Organic Farm Fresh Milk</span>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa fa-check-circle text-success me-2 fs-5"></i>
                        <span>No Artificial Preservatives</span>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa fa-check-circle text-success me-2 fs-5"></i>
                        <span>Handcrafted Artisan Batches</span>
                    </div>
                    <a href="/products" class="btn btn-primary rounded-pill btn-sm text-white fw-bold" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">Order Online</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SERVICES CARDS -->
<section class="container-fluid py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="font-playfair fw-bold text-dark">Why Ice Cream Lovers Choose Us</h2>
            <p class="text-muted">Delivering premium taste, supreme quality, and smiles everywhere</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4">
                    <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center text-white mb-3" style="width:60px; height:60px; background: linear-gradient(135deg, #F195B2, #62C3E7);">
                        <i class="fas fa-award fa-2x"></i>
                    </div>
                    <h5 class="fw-bold">Premium Quality</h5>
                    <p class="text-muted small">Only the finest vanilla beans, cocoa, and fresh fruits in every scoop.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4">
                    <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center text-white mb-3" style="width:60px; height:60px; background: linear-gradient(135deg, #F195B2, #62C3E7);">
                        <i class="fas fa-truck-fast fa-2x"></i>
                    </div>
                    <h5 class="fw-bold">Fast Cold Delivery</h5>
                    <p class="text-muted small">Specialized thermal packaging keeps your ice cream perfectly frozen.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4">
                    <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center text-white mb-3" style="width:60px; height:60px; background: linear-gradient(135deg, #F195B2, #62C3E7);">
                        <i class="fas fa-birthday-cake fa-2x"></i>
                    </div>
                    <h5 class="fw-bold">Event Catering</h5>
                    <p class="text-muted small">Custom ice cream cakes and parlor pop-ups for weddings and parties.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 text-center p-4">
                    <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center text-white mb-3" style="width:60px; height:60px; background: linear-gradient(135deg, #F195B2, #62C3E7);">
                        <i class="fas fa-leaf fa-2x"></i>
                    </div>
                    <h5 class="fw-bold">Vegan &amp; Sorbet</h5>
                    <p class="text-muted small">Refreshing 100% dairy-free sorbets and almond milk ice creams.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PRODUCTS PREVIEW -->
<section class="container-fluid py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="font-playfair fw-bold mb-1">Featured Ice Cream Flavors</h2>
                <p class="text-muted mb-0">Handpicked customer favorites available for immediate order</p>
            </div>
            <a href="/products" class="btn btn-outline-primary rounded-pill fw-bold">View All Products →</a>
        </div>
        <div class="row g-4">
            <% products.slice(0, 4).forEach(product => { %>
                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 position-relative">
                        <% if (product.discountPercent > 0) { %>
                            <span class="position-absolute top-0 start-0 m-3 badge bg-danger rounded-pill px-3 py-2 fw-bold"><%= product.discountPercent %>% OFF</span>
                        <% } %>
                        <img src="<%= product.imagePath %>" class="card-img-top" alt="<%= product.name %>" style="height: 200px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column p-4">
                            <span class="badge bg-light text-primary align-self-start mb-2 px-3 py-1 rounded-pill border"><%= product.categoryName %></span>
                            <h5 class="fw-bold card-title"><%= product.name %></h5>
                            <p class="text-muted small flex-grow-1"><%= product.description.substring(0, 70) %>...</p>
                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <div>
                                    <span class="fs-5 fw-bold text-primary">$<%= product.price.toFixed(2) %></span>
                                </div>
                                <form action="/cart/add" method="POST" class="d-inline">
                                    <input type="hidden" name="productId" value="<%= product.id %>" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-sm text-white rounded-pill px-3 fw-bold" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                                        <i class="fas fa-shopping-cart me-1"></i> Order
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<%- include('../partials/membership_banner') %>

<%- include('../partials/footer') %>
