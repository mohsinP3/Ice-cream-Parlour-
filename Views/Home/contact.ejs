<%- include('../partials/header') %>

<div class="bg-primary text-white py-5 text-center" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
    <div class="container py-2">
        <h1 class="display-4 font-playfair fw-bold">Contact Us</h1>
        <p class="lead mb-0">We'd love to hear from you! Reach out for catering, feedback, or general queries.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <!-- Contact Information Card -->
        <div class="col-lg-5">
            <div class="bg-white rounded-4 shadow-sm border p-4 p-md-5 h-100">
                <h3 class="font-playfair fw-bold mb-4">Get In Touch</h3>
                <div class="d-flex align-items-start mb-4">
                    <div class="rounded-circle p-3 text-white me-3" style="background: #F195B2;"><i class="fas fa-map-marker-alt fa-lg"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Our Parlour Location</h6>
                        <p class="text-muted small mb-0">123 Ice Cream Street, New York, NY 10001</p>
                    </div>
                </div>
                <div class="d-flex align-items-start mb-4">
                    <div class="rounded-circle p-3 text-white me-3" style="background: #62C3E7;"><i class="fas fa-phone-alt fa-lg"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Call Us Directly</h6>
                        <p class="text-muted small mb-0">+1 (012) 345 6789</p>
                    </div>
                </div>
                <div class="d-flex align-items-start mb-4">
                    <div class="rounded-circle p-3 text-white me-3" style="background: #F195B2;"><i class="fas fa-envelope fa-lg"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Email Support</h6>
                        <p class="text-muted small mb-0">info@icream.com</p>
                    </div>
                </div>
                <div class="d-flex align-items-start">
                    <div class="rounded-circle p-3 text-white me-3" style="background: #62C3E7;"><i class="fas fa-clock fa-lg"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1">Operating Hours</h6>
                        <p class="text-muted small mb-0">Mon – Sat: 8:00 AM – 9:00 PM<br>Sun: 10:00 AM – 6:00 PM</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Form Card -->
        <div class="col-lg-7">
            <div class="bg-white rounded-4 shadow-sm border p-4 p-md-5">
                <h3 class="font-playfair fw-bold mb-4">Send Us A Message</h3>
                <form action="/contact" method="POST">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Your Name *</label>
                            <input type="text" name="name" class="form-control rounded-3" placeholder="John Doe" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Your Email *</label>
                            <input type="email" name="email" class="form-control rounded-3" placeholder="you@example.com" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Subject</label>
                            <input type="text" name="subject" class="form-control rounded-3" placeholder="e.g., Party Catering Inquiry" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Message *</label>
                            <textarea name="message" class="form-control rounded-3" rows="5" placeholder="Write your message here..." required></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-3 mt-4 text-white fw-bold shadow" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                        Send Message <i class="fas fa-paper-plane ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
