@model IEnumerable<Ice_Cream_Parlour_Eproject.Areas.Models.Product>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Artisanal Ice Cream Products & Pricing Menu";
    ViewData["MetaDescription"] = "Browse the premium range of iCREAM's traditional, rich, and delicious ice creams. Check out our pricing menu, custom scoop cones, and catering list.";
    ViewData["MetaKeywords"] = "ice cream products, chocolate fudge, vanilla cone, mint chip, rolled ice cream, catering tray, strawberry bliss pricing";
}
    <!-- Header Start -->
    <div class="jumbotron jumbotron-fluid page-header" style="margin-bottom: 90px; background-image:url('/img/header.jpg');">
        <div class="container text-center py-5">
            <h1 class="text-white display-3 mt-lg-5">Product</h1>
            <div class="d-inline-flex align-items-center text-white">
                <p class="m-0"><a class="text-white" asp-action="Index" asp-controller="Home">Home</a></p>
                <i class="fa fa-circle px-3"></i>
                <p class="m-0">Product</p>
            </div>
        </div>
    </div>
    <!-- Header End -->
    <!-- Products Start -->
    <div class="container-fluid py-5">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <h1 class="section-title position-relative text-center mb-5">Best Prices We Offer For Ice Cream Lovers</h1>
                </div>
            </div>
            <div class="row">
                @if (Model != null && Model.Any())
                {
                    @foreach (var product in Model)
                    {
                        <div class="col-lg-3 col-md-6 mb-4 pb-2">
                            <div class="product-item d-flex flex-column align-items-center text-center bg-light rounded py-5 px-3 h-100" style="transition: .5s; min-height: 400px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
                                <div class="bg-primary mt-n5 py-2" style="width: 90px; border-radius: 30px; box-shadow: 0 4px 10px rgba(241,149,178,0.3);">
                                    <h5 class="font-weight-bold text-white mb-0">$@product.Price.ToString("0.00")</h5>
                                </div>
                                <div class="position-relative bg-primary rounded-circle mt-3 mb-4 p-3" style="width: 150px; height: 150px; box-shadow: 0 8px 20px rgba(241,149,178,0.15);">
                                    <img class="rounded-circle w-100 h-100" src="@(string.IsNullOrEmpty(product.ImagePath) ? "/img/product-1.jpg" : product.ImagePath)" style="object-fit: cover;" alt="@product.Name">
                                </div>
                                <h5 class="font-weight-bold mb-2">@product.Name</h5>
                                <p class="text-muted small mb-3" style="font-size: 0.85rem; line-height: 1.4;">@product.Description</p>
                                <div class="mt-auto">
                                    <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-secondary px-4 py-2" style="border-radius: 30px; font-weight: 600; box-shadow: 0 4px 12px rgba(98,195,231,0.2);">Order Now</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Fallback static products -->
                    <!-- Product 1 -->
                    <div class="col-lg-3 col-md-6 mb-4 pb-2">
                        <div class="product-item d-flex flex-column align-items-center text-center bg-light rounded py-5 px-3 h-100" style="transition: .5s; min-height: 400px;">
                            <div class="bg-primary mt-n5 py-3" style="width: 80px; border-radius:10px;">
                                <h4 class="font-weight-bold text-white mb-0">$9.99</h4>
                            </div>
                            <div class="position-relative bg-primary rounded-circle mt-n3 mb-4 p-3" style="width: 150px; height: 150px;">
                                <img class="rounded-circle w-100 h-100" src="~/img/product-4.jpg" style="object-fit: cover;" alt="Vanilla Ice Cream">
                            </div>
                            <h5 class="font-weight-bold mb-4">Vanilla Ice Cream</h5>
                            <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-secondary mt-auto px-4 py-2" style="border-radius:30px;">Order Now</a>
                        </div>
                    </div>

                    <!-- Product 2 -->
                    <div class="col-lg-3 col-md-6 mb-4 pb-2">
                        <div class="product-item d-flex flex-column align-items-center text-center bg-light rounded py-5 px-3 h-100" style="transition: .5s; min-height: 400px;">
                            <div class="bg-primary mt-n5 py-3" style="width: 80px; border-radius:10px;">
                                <h4 class="font-weight-bold text-white mb-0">$9.99</h4>
                            </div>
                            <div class="position-relative bg-primary rounded-circle mt-n3 mb-4 p-3" style="width: 150px; height: 150px;">
                                <img class="rounded-circle w-100 h-100" src="https://images.unsplash.com/photo-1563805042-7684c019e1cb?q=80&w=600&auto=format&fit=crop" style="object-fit: cover;" alt="Chocolate Fudge">
                            </div>
                            <h5 class="font-weight-bold mb-4">Chocolate Fudge</h5>
                            <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-secondary mt-auto px-4 py-2" style="border-radius:30px;">Order Now</a>
                        </div>
                    </div>

                    <!-- Product 3 -->
                    <div class="col-lg-3 col-md-6 mb-4 pb-2">
                        <div class="product-item d-flex flex-column align-items-center text-center bg-light rounded py-5 px-3 h-100" style="transition: .5s; min-height: 400px;">
                            <div class="bg-primary mt-n5 py-3" style="width: 80px; border-radius:10px;">
                                <h4 class="font-weight-bold text-white mb-0">$9.99</h4>
                            </div>
                            <div class="position-relative bg-primary rounded-circle mt-n3 mb-4 p-3" style="width: 150px; height: 150px;">
                                <img class="rounded-circle w-100 h-100" src="~/img/carousel-1.jpg" style="object-fit: cover;" alt="Strawberry Bliss">
                            </div>
                            <h5 class="font-weight-bold mb-4">Strawberry Bliss</h5>
                            <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-secondary mt-auto px-4 py-2" style="border-radius:30px;">Order Now</a>
                        </div>
                    </div>

                    <!-- Product 4 -->
                    <div class="col-lg-3 col-md-6 mb-4 pb-2">
                        <div class="product-item d-flex flex-column align-items-center text-center bg-light rounded py-5 px-3 h-100" style="transition: .5s; min-height: 400px;">
                            <div class="bg-primary mt-n5 py-3" style="width: 80px; border-radius:10px;">
                                <h4 class="font-weight-bold text-white mb-0">$9.99</h4>
                            </div>
                            <div class="position-relative bg-primary rounded-circle mt-n3 mb-4 p-3" style="width: 150px; height: 150px;">
                                <img class="rounded-circle w-100 h-100" src="https://images.unsplash.com/photo-1501443715940-a536eae44c1f?q=80&w=600&auto=format&fit=crop" style="object-fit: cover;" alt="Mint Chip">
                            </div>
                            <h5 class="font-weight-bold mb-4">Mint Chip</h5>
                            <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-secondary mt-auto px-4 py-2" style="border-radius:30px;">Order Now</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <!-- Products End -->