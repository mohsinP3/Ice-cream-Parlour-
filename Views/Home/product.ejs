<%- include('../partials/header') %>

<div class="bg-light py-4 border-bottom">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2 class="font-playfair fw-bold mb-1">Our Ice Cream Products</h2>
                <p class="text-muted mb-0">Browse our handcrafted scoops, gelatos, cakes, and sundaes</p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <a href="/cart" class="btn btn-outline-primary rounded-pill px-4 fw-bold"><i class="fas fa-shopping-bag me-2"></i>View Cart (<%= cartCount %>)</a>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Filters & Search -->
    <div class="row mb-4 g-3 align-items-center bg-white p-3 rounded-4 shadow-sm border">
        <div class="col-md-6">
            <div class="d-flex flex-wrap gap-2">
                <a href="/products" class="btn btn-sm rounded-pill px-3 <%= !selectedCategory ? 'btn-primary text-white' : 'btn-outline-secondary' %>">All Categories</a>
                <% categories.forEach(cat => { %>
                    <a href="/products?category=<%= cat.id %>" class="btn btn-sm rounded-pill px-3 <%= selectedCategory == cat.id ? 'btn-primary text-white' : 'btn-outline-secondary' %>"><%= cat.name %></a>
                <% }); %>
            </div>
        </div>
        <div class="col-md-6">
            <form action="/products" method="GET" class="d-flex gap-2">
                <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>" /><% } %>
                <input type="text" name="search" value="<%= searchQuery || '' %>" placeholder="Search flavor, e.g. Vanilla, Chocolate..." class="form-control rounded-pill border-1" />
                <button type="submit" class="btn btn-primary rounded-pill px-4 text-white" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;"><i class="fas fa-search"></i></button>
            </form>
        </div>
    </div>

    <!-- Product Grid -->
    <div class="row g-4">
        <% if (products.length === 0) { %>
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-white rounded-4 border shadow-sm my-4">
                    <i class="fas fa-ice-cream fa-4x text-muted mb-3"></i>
                    <h4 class="fw-bold">No Ice Cream Products Found</h4>
                    <p class="text-muted">Try selecting another category or clear your search query.</p>
                    <a href="/products" class="btn btn-primary rounded-pill px-4">Reset Filters</a>
                </div>
            </div>
        <% } else { %>
            <% products.forEach(product => { %>
                <div class="col-lg-3 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <div class="position-relative">
                            <img src="<%= product.imagePath %>" class="card-img-top" alt="<%= product.name %>" style="height: 220px; object-fit: cover;" />
                            <% if (product.discountPercent > 0) { %>
                                <span class="position-absolute top-0 start-0 m-3 badge bg-danger rounded-pill px-3 py-2 fw-bold"><%= product.discountPercent %>% OFF</span>
                            <% } %>
                            <% if (product.stockQuantity <= 0) { %>
                                <span class="position-absolute top-0 end-0 m-3 badge bg-secondary rounded-pill px-3 py-2">Out of Stock</span>
                            <% } else if (product.stockQuantity <= product.lowStockThreshold) { %>
                                <span class="position-absolute top-0 end-0 m-3 badge bg-warning text-dark rounded-pill px-3 py-2">Only <%= product.stockQuantity %> left</span>
                            <% } %>
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <span class="badge bg-light text-primary align-self-start mb-2 px-3 py-1 rounded-pill border"><%= product.categoryName %></span>
                            <h5 class="fw-bold card-title"><%= product.name %></h5>
                            <p class="text-muted small flex-grow-1"><%= product.description %></p>
                            
                            <div class="d-flex align-items-center justify-content-between mt-3 pt-3 border-top">
                                <div>
                                    <span class="fs-5 fw-bold text-primary">$<%= product.price.toFixed(2) %></span>
                                    <% if (product.discountPercent > 0) { %>
                                        <small class="text-muted text-decoration-line-through ms-1">$<%= (product.price * (1 + product.discountPercent/100)).toFixed(2) %></small>
                                    <% } %>
                                </div>
                                <% if (product.stockQuantity > 0) { %>
                                    <form action="/cart/add" method="POST" class="d-inline">
                                        <input type="hidden" name="productId" value="<%= product.id %>" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-sm text-white rounded-pill px-3 fw-bold" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                                            <i class="fas fa-shopping-cart me-1"></i> Add to Cart
                                        </button>
                                    </form>
                                <% } else { %>
                                    <button disabled class="btn btn-sm btn-secondary rounded-pill px-3">Unavailable</button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
