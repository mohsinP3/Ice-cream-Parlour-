<%- include('../partials/header') %>

<div class="bg-primary text-white py-5 text-center" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
    <div class="container py-2">
        <h1 class="display-4 font-playfair fw-bold">iCREAM Photo Gallery</h1>
        <p class="lead mb-0">Visual showcases of our artisan scoops, cakes, and parlour moments</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <% [1,2,3,4,5,6,7,8].forEach(num => { %>
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative group">
                    <img src="/img/portfolio-<%= num %>.jpg" class="img-fluid w-100" style="height:220px; object-fit:cover;" alt="Gallery Ice Cream <%= num %>" />
                    <div class="card-img-overlay bg-dark bg-opacity-25 opacity-0 hover-opacity-100 d-flex align-items-center justify-content-center transition">
                        <span class="btn btn-light rounded-circle p-3 shadow"><i class="fas fa-search-plus text-primary fs-4"></i></span>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<%- include('../partials/footer') %>
