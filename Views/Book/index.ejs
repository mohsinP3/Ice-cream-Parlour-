<%- include('../partials/header') %>

<div class="bg-primary text-white py-5 text-center" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
    <div class="container py-2">
        <h1 class="display-4 font-playfair fw-bold">Ice Cream Recipe Books</h1>
        <p class="lead mb-0">Official guidebooks and recipe collections written by our master chefs</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <% books.forEach(book => { %>
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                    <img src="<%= book.imagePath %>" class="card-img-top" alt="<%= book.title %>" style="height: 250px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column p-4">
                        <small class="text-primary fw-bold text-uppercase mb-1"><i class="fas fa-feather-alt me-1"></i>By <%= book.author %></small>
                        <h4 class="fw-bold card-title mb-2"><%= book.title %></h4>
                        <p class="text-muted small flex-grow-1"><%= book.description %></p>
                        
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-2">
                            <span class="fs-4 fw-bold text-primary">$<%= book.price.toFixed(2) %></span>
                            <a href="/books/order/<%= book.id %>" class="btn btn-primary rounded-pill px-4 text-white fw-bold shadow-sm" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                                Order Book <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<%- include('../partials/footer') %>
