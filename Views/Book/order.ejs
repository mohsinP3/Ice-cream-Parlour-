<%- include('../partials/header') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4 text-center" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
                    <h3 class="font-playfair fw-bold mb-1">Order Recipe Book</h3>
                    <p class="mb-0 text-white-50"><%= book.title %> — $<%= book.price.toFixed(2) %></p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form action="/books/order" method="POST">
                        <input type="hidden" name="bookId" value="<%= book.id %>" />
                        <input type="hidden" name="totalAmount" value="<%= book.price %>" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Full Name *</label>
                                <input type="text" name="customerName" class="form-control rounded-3" value="<%= currentUser ? currentUser.fullName : '' %>" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Email Address *</label>
                                <input type="email" name="customerEmail" class="form-control rounded-3" value="<%= currentUser ? currentUser.email : '' %>" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Phone Number *</label>
                                <input type="text" name="customerPhone" class="form-control rounded-3" placeholder="+1 (555) 000-0000" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Payment Method *</label>
                                <select name="paymentMethod" class="form-select rounded-3">
                                    <option value="Cash on Delivery">Cash on Delivery</option>
                                    <option value="Credit Card">Credit Card</option>
                                    <option value="PayPal">PayPal</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Delivery Address *</label>
                                <textarea name="deliveryAddress" class="form-control rounded-3" rows="3" placeholder="Street address, city, state, zip code" required><%= currentUser ? currentUser.address : '' %></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">Order Notes (Optional)</label>
                                <textarea name="notes" class="form-control rounded-3" rows="2" placeholder="Special delivery instructions..."></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a href="/books" class="btn btn-outline-secondary rounded-pill px-4">← Back to Books</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 text-white fw-bold shadow" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                                Confirm Book Order ($<%= book.price.toFixed(2) %>)
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
