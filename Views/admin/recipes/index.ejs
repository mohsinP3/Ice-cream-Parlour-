<%- include('../partials/admin_header') %>

<div class="row g-4">
    <!-- Add Recipe Form -->
    <div class="col-lg-5">
        <div class="bg-white rounded-4 shadow-sm border p-4">
            <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-plus-circle text-primary me-2"></i>Add Artisan Recipe</h5>
            <form action="/admin/recipes/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-bold">Recipe Name *</label>
                    <input type="text" name="name" class="form-control rounded-3" placeholder="e.g. Pistachio Gelato" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Category *</label>
                    <input type="text" name="category" class="form-control rounded-3" placeholder="Gelato &amp; Sorbet" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Access Level</label>
                    <select name="isFree" class="form-select rounded-3">
                        <option value="true">Free (All Users)</option>
                        <option value="false">Members Only (Paid VIP)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Ingredients *</label>
                    <textarea name="ingredients" class="form-control rounded-3" rows="3" required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Procedure *</label>
                    <textarea name="procedure" class="form-control rounded-3" rows="4" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 text-white fw-bold shadow-sm" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                    Save Recipe
                </button>
            </form>
        </div>
    </div>

    <!-- Recipes Table -->
    <div class="col-lg-7">
        <div class="bg-white rounded-4 shadow-sm border p-4">
            <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-utensils text-primary me-2"></i>Recipes Directory (<%= recipes.length %>)</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Recipe Name</th>
                            <th>Category</th>
                            <th>Access</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recipes.forEach(r => { %>
                            <tr>
                                <td class="fw-bold text-primary"><%= r.name %></td>
                                <td><span class="badge bg-light text-dark border"><%= r.category %></span></td>
                                <td>
                                    <% if (r.isFree) { %>
                                        <span class="badge bg-success rounded-pill">Free</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark rounded-pill">Members Only</span>
                                    <% } %>
                                </td>
                                <td class="text-end">
                                    <form action="/admin/recipes/delete/<%= r.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete recipe?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-2"><i class="fas fa-trash-alt"></i></button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/admin_footer') %>
