<%- include('../partials/admin_header') %>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
            <span class="text-muted small fw-bold text-uppercase">Total Sales Revenue</span>
            <h2 class="fw-bold text-success mt-2 mb-0">$<%= totalRevenue.toFixed(2) %></h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
            <span class="text-muted small fw-bold text-uppercase">Completed Orders</span>
            <h2 class="fw-bold text-primary mt-2 mb-0"><%= completedOrders %></h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
            <span class="text-muted small fw-bold text-uppercase">Average Order Value</span>
            <h2 class="fw-bold text-dark mt-2 mb-0">$<%= (completedOrders > 0 ? totalRevenue / completedOrders : 0).toFixed(2) %></h2>
        </div>
    </div>
</div>

<div class="bg-white rounded-4 shadow-sm border p-4 p-md-5">
    <h5 class="fw-bold mb-4 text-dark"><i class="fas fa-chart-line text-primary me-2"></i>Sales &amp; Revenue Analytics Breakdown</h5>
    
    <div class="table-responsive">
        <table class="table table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Category</th>
                    <th>Product Count</th>
                    <th>Stock Remaining</th>
                    <th>Performance Status</th>
                </tr>
            </thead>
            <tbody>
                <% categories.forEach(cat => { %>
                    <tr>
                        <td class="fw-bold text-primary"><%= cat.name %></td>
                        <td><%= products.filter(p => p.categoryId == cat.id).length %> items</td>
                        <td><%= products.filter(p => p.categoryId == cat.id).reduce((acc, p) => acc + p.stockQuantity, 0) %> units</td>
                        <td><span class="badge bg-success rounded-pill">High Demand</span></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/admin_footer') %>
