<%- include('../partials/admin_header') %>

<div class="bg-white rounded-4 shadow-sm border p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-users text-primary me-2"></i>Customer Accounts (<%= customers.length %>)</h5>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Registered</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% customers.forEach(c => { %>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="<%= c.profileImagePath || '/img/team-1.jpg' %>" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;" alt="<%= c.fullName %>" />
                                <span class="fw-bold"><%= c.fullName %></span>
                            </div>
                        </td>
                        <td><%= c.email %></td>
                        <td class="small text-muted"><%= c.phone || 'N/A' %></td>
                        <td class="small text-muted"><%= c.address || 'N/A' %></td>
                        <td class="small text-muted"><%= c.createdAt %></td>
                        <td><span class="badge bg-success rounded-pill">Active</span></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/admin_footer') %>
