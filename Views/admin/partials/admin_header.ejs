<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title + ' - iCREAM Admin' : 'Admin Panel - iCREAM Parlour' %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        body { font-family: 'Poppins', sans-serif; background-color: #f4f6f9; color: #333; }
        .sidebar { width: 260px; min-height: 100vh; background: #1e1e2d; color: #92929f; transition: all 0.3s; }
        .sidebar .nav-link { color: #92929f; padding: 12px 20px; font-size: 0.95rem; display: flex; align-items: center; gap: 12px; border-radius: 10px; margin: 4px 12px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background: rgba(241,149,178,0.15); color: #F195B2; font-weight: 600; }
        .sidebar-brand { padding: 20px; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .main-content { flex: 1; padding: 30px; }
        .stat-card { border: none; border-radius: 16px; transition: transform 0.2s; }
        .stat-card:hover { transform: translateY(-3px); }
    </style>
</head>
<body>
<div class="d-flex">
    <!-- Sidebar Navigation -->
    <aside class="sidebar d-flex flex-column flex-shrink-0 shadow">
        <div class="sidebar-brand">
            <h3 class="m-0 fw-bold"><span style="color:#F195B2;">i</span><span style="color:#62C3E7;">CREAM</span> <span class="badge bg-danger fs-6 align-middle">Admin</span></h3>
        </div>
        <ul class="nav nav-pills flex-column mt-3 mb-auto">
            <li class="nav-item">
                <a href="/admin/dashboard" class="nav-link <%= activeNav === 'dashboard' ? 'active' : '' %>"><i class="fas fa-chart-pie fa-fw"></i> Dashboard</a>
            </li>
            <li class="nav-item">
                <a href="/admin/orders" class="nav-link <%= activeNav === 'orders' ? 'active' : '' %>"><i class="fas fa-shopping-cart fa-fw"></i> Orders</a>
            </li>
            <li class="nav-item">
                <a href="/admin/products" class="nav-link <%= activeNav === 'products' ? 'active' : '' %>"><i class="fas fa-ice-cream fa-fw"></i> Products</a>
            </li>
            <li class="nav-item">
                <a href="/admin/categories" class="nav-link <%= activeNav === 'categories' ? 'active' : '' %>"><i class="fas fa-tags fa-fw"></i> Categories</a>
            </li>
            <li class="nav-item">
                <a href="/admin/customers" class="nav-link <%= activeNav === 'customers' ? 'active' : '' %>"><i class="fas fa-users fa-fw"></i> Customers</a>
            </li>
            <li class="nav-item">
                <a href="/admin/recipes" class="nav-link <%= activeNav === 'recipes' ? 'active' : '' %>"><i class="fas fa-utensils fa-fw"></i> Recipes</a>
            </li>
            <li class="nav-item">
                <a href="/admin/books" class="nav-link <%= activeNav === 'books' ? 'active' : '' %>"><i class="fas fa-book fa-fw"></i> Recipe Books</a>
            </li>
            <li class="nav-item">
                <a href="/admin/reports" class="nav-link <%= activeNav === 'reports' ? 'active' : '' %>"><i class="fas fa-file-invoice-dollar fa-fw"></i> Reports</a>
            </li>
        </ul>
        <div class="p-3 border-top border-secondary">
            <a href="/" class="btn btn-outline-light w-100 btn-sm rounded-pill mb-2"><i class="fas fa-globe me-1"></i> Public Website</a>
            <a href="/account/logout" class="btn btn-danger w-100 btn-sm rounded-pill"><i class="fas fa-sign-out-alt me-1"></i> Logout</a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="main-content">
        <!-- Top Header Bar -->
        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
            <div>
                <h4 class="fw-bold mb-0 text-dark"><%= title || 'Admin Dashboard' %></h4>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small"><i class="fas fa-user-circle me-1"></i> Logged in as <strong><%= currentUser ? currentUser.fullName : 'Admin' %></strong></span>
            </div>
        </div>

        <!-- Alert messages -->
        <% if (typeof successMsg !== 'undefined' && successMsg) { %>
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
                <i class="fas fa-check-circle me-2"></i><%= successMsg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i><%= errorMsg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
