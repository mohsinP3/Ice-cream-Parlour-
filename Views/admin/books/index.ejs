<%- include('../partials/admin_header') %>

<div class="row g-4">
    <!-- Add Book Form -->
    <div class="col-lg-4">
        <div class="bg-white rounded-4 shadow-sm border p-4">
            <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-plus-circle text-primary me-2"></i>Add Recipe Book</h5>
            <form action="/admin/books/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-bold">Book Title *</label>
                    <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Master Gelato Guide" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Author *</label>
                    <input type="text" name="author" class="form-control rounded-3" placeholder="Chef Antonio Rossi" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Price ($) *</label>
                    <input type="number" step="0.01" name="price" class="form-control rounded-3" placeholder="24.99" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea name="description" class="form-control rounded-3" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 text-white fw-bold shadow-sm" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                    Save Book
                </button>
            </form>
        </div>
    </div>

    <!-- Books List Table -->
    <div class="col-lg-8">
        <div class="bg-white rounded-4 shadow-sm border p-4">
            <h5 class="fw-bold mb-3 text-dark"><i class="fas fa-book text-primary me-2"></i>Recipe Books Catalog (<%= books.length %>)</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Book Title</th>
                            <th>Author</th>
                            <th>Price</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% books.forEach(b => { %>
                            <tr>
                                <td class="fw-bold text-primary"><%= b.title %></td>
                                <td><%= b.author %></td>
                                <td class="fw-bold">$<%= b.price.toFixed(2) %></td>
                                <td class="text-end">
                                    <form action="/admin/books/delete/<%= b.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete book?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-2"><i class="fas fa-trash-alt"></i></button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/admin_footer') %>
