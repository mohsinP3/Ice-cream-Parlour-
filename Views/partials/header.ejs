<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title + ' - iCREAM' : 'iCREAM - Artisan Ice Cream Parlour' %></title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & FontAwesome -->
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/responsive.css" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-2 sticky-top">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <!-- Left links -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link <%= activeNav === 'home' ? 'active fw-bold text-primary' : '' %>" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link <%= activeNav === 'about' ? 'active fw-bold text-primary' : '' %>" href="/about">About</a></li>
                    <li class="nav-item"><a class="nav-link <%= activeNav === 'products' ? 'active fw-bold text-primary' : '' %>" href="/products">Products</a></li>
                    <li class="nav-item"><a class="nav-link <%= activeNav === 'recipes' ? 'active fw-bold text-primary' : '' %>" href="/recipes">Recipes</a></li>
                </ul>

                <!-- Centered Brand -->
                <a class="navbar-brand mx-auto py-0" href="/">
                    <h1 class="m-0 display-5 font-playfair text-primary" style="letter-spacing: -1px;"><span style="color:#F195B2;">i</span><span style="color:#62C3E7;">CREAM</span></h1>
                </a>

                <!-- Right links -->
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link <%= activeNav === 'books' ? 'active fw-bold text-primary' : '' %>" href="/books">Books</a></li>
                    <li class="nav-item"><a class="nav-link <%= activeNav === 'gallery' ? 'active fw-bold text-primary' : '' %>" href="/gallery">Gallery</a></li>
                    <li class="nav-item"><a class="nav-link <%= activeNav === 'contact' ? 'active fw-bold text-primary' : '' %>" href="/contact">Contact</a></li>

                    <!-- Cart Icon with badge -->
                    <li class="nav-item me-2">
                        <a class="nav-link position-relative px-2" href="/cart" title="Shopping Cart">
                            <i class="fas fa-shopping-bag fa-lg text-secondary"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cartCountBadge">
                                <%= cartCount || 0 %>
                            </span>
                        </a>
                    </li>

                    <!-- User Menu / Auth -->
                    <% if (currentUser) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 4px 8px;">
                                <% if (currentUser.profilePicture) { %>
                                    <img src="<%= currentUser.profilePicture %>" alt="Avatar" style="width:32px; height:32px; border-radius:50%; object-fit:cover;" />
                                <% } else { %>
                                    <span style="display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:50%; background: linear-gradient(135deg, #F195B2, #62C3E7); color:#fff; font-weight:700; font-size:14px;">
                                        <%= (currentUser.fullName || currentUser.email || 'U').charAt(0).toUpperCase() %>
                                    </span>
                                <% } %>
                                <span class="d-none d-sm-inline fw-medium"><%= currentUser.fullName || currentUser.email %></span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown" style="border-radius:16px; padding:8px; min-width:200px;">
                                <% if (currentUser.role === 'Admin') { %>
                                    <li><a class="dropdown-item text-primary fw-bold" href="/admin/dashboard"><i class="fas fa-chart-line me-2"></i>Admin Panel</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                <% } %>
                                <li><a class="dropdown-item" href="/account/profile"><i class="fas fa-user-circle me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item" href="/orders/history"><i class="fas fa-receipt me-2"></i>My Orders</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="/account/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a>
                                </li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3 me-2" href="/account/login"><i class="fas fa-sign-in-alt me-1"></i> Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm rounded-pill px-3 text-white" href="/account/register" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;"><i class="fas fa-user-plus me-1"></i> Register</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Flash Alert Messages -->
    <div class="container mt-3">
        <% if (typeof successMsg !== 'undefined' && successMsg) { %>
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
                <i class="fas fa-check-circle me-2"></i><%= successMsg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i><%= errorMsg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    </div>
