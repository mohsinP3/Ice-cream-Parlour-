<% if (!currentUser || !currentUser.isPaid) { %>
    <div class="membership-banner shadow-sm my-4" style="background: linear-gradient(135deg, #fff, #fef8f5); border-top: 4px solid #F195B2; border-bottom: 1px solid rgba(0,0,0,0.05); padding: 20px 0;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3">
                        <div style="background: linear-gradient(135deg, #F195B2, #62C3E7); width: 55px; height: 55px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22px; flex-shrink: 0; box-shadow: 0 4px 15px rgba(241,149,178,0.3);">
                            <i class="fas fa-crown"></i>
                        </div>
                        <div>
                            <h5 style="font-weight: 700; margin-bottom: 2px; color: #2d2d2d;">🍦 Full recipes for members only</h5>
                            <p style="margin: 0; color: #888; font-size: 0.95rem;">Join membership to unlock 20+ artisan recipes &amp; exclusive content</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="d-flex flex-wrap gap-2 justify-content-md-end align-items-center">
                        <span style="background: #F195B2; color: #fff; padding: 4px 14px; border-radius: 50px; font-size: 0.85rem; font-weight: 600;">$15 / month</span>
                        <span style="background: #62C3E7; color: #fff; padding: 4px 14px; border-radius: 50px; font-size: 0.85rem; font-weight: 600;">$150 / year</span>
                        <a href="/account/register" class="btn btn-primary btn-sm rounded-pill px-4" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border: none; font-weight: 600;">Join Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
<% } %>
