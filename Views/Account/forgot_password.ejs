<%- include('../partials/header') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
                    <h3 class="font-playfair fw-bold mb-1">Reset Password</h3>
                    <p class="mb-0 text-white-50">Enter your email address to receive reset instructions</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form action="/account/forgot-password" method="POST">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Email Address</label>
                            <input type="email" name="email" class="form-control rounded-3" placeholder="you@example.com" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 text-white fw-bold shadow" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                            Send Reset Link <i class="fas fa-paper-plane ms-1"></i>
                        </button>
                    </form>
                    <div class="text-center mt-4 pt-3 border-top">
                        <a href="/account/login" class="text-primary fw-bold text-decoration-none">← Back to Sign In</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
