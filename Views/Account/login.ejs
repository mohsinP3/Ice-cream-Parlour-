<%- include('../partials/header') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #F195B2, #62C3E7) !important;">
                    <h3 class="font-playfair fw-bold mb-1">Welcome Back</h3>
                    <p class="mb-0 text-white-50">Sign in to your iCREAM account</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <!-- Quick Demo Accounts Toggle -->
                    <div class="p-3 bg-light rounded-3 mb-4 text-center border">
                        <small class="text-muted fw-bold d-block mb-2">⚡ Quick Demo Login:</small>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="fillAdmin()">Admin Login</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="fillUser()">User Login</button>
                        </div>
                    </div>

                    <form action="/account/login" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                                <input type="email" id="loginEmail" name="email" class="form-control" placeholder="admin@icream.com" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                                <input type="password" id="loginPassword" name="password" class="form-control" placeholder="••••••••" required />
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" />
                                <label class="form-check-label small" for="rememberMe">Remember me</label>
                            </div>
                            <a href="/account/forgot-password" class="small text-primary text-decoration-none fw-bold">Forgot Password?</a>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 text-white fw-bold shadow" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                            Sign In <i class="fas fa-sign-in-alt ms-1"></i>
                        </button>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <p class="text-muted small mb-0">Don't have an account? <a href="/account/register" class="text-primary fw-bold text-decoration-none">Register here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function fillAdmin() {
        document.getElementById('loginEmail').value = 'admin@icream.com';
        document.getElementById('loginPassword').value = 'admin123';
    }
    function fillUser() {
        document.getElementById('loginEmail').value = 'user@icream.com';
        document.getElementById('loginPassword').value = 'user123';
    }
</script>

<%- include('../partials/footer') %>
