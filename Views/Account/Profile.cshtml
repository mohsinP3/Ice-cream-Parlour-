@model Ice_Cream_Parlour_Eproject.Models.User
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile - iCREAM";
}

<!-- ===== PROFILE CONTENT ===== -->
<section style="padding: 30px 0; width: 100%;">
    <div style="max-width: 700px; margin: 0 auto; padding: 0 15px;">

        <!-- Profile Card -->
        <div style="background: #fff; border-radius: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.06); padding: 30px; border: 1px solid rgba(241,149,178,0.08);">

            <!-- ============================================================ -->
            <!-- ===== AVATAR WITH PENCIL ICON OVERLAY ===== -->
            <!-- ============================================================ -->
            <div style="text-align: center; margin-bottom: 25px; position: relative; display: inline-block; width: 100%;">

                <!-- Avatar Container -->
                <div style="position: relative; display: inline-block; cursor: pointer;" onclick="document.getElementById('fileInput').click();">

                    <!-- Avatar Image / Initials -->
                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img id="profileImage" src="@Model.ProfilePicture" alt="Profile" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 4px solid #F195B2; box-shadow: 0 4px 15px rgba(241,149,178,0.3); transition: 0.3s;" onmouseover="this.style.opacity='0.7';" onmouseout="this.style.opacity='1';" />
                    }
                    else
                    {
                        <div id="profileInitials" style="width: 120px; height: 120px; border-radius: 50%; background: linear-gradient(135deg, #F195B2, #62C3E7); display: inline-flex; align-items: center; justify-content: center; font-size: 3rem; font-weight: 700; color: #fff; border: 4px solid #F195B2; box-shadow: 0 4px 15px rgba(241,149,178,0.3); transition: 0.3s;">
                            @{
                                var initials = "";
                                if (!string.IsNullOrEmpty(Model.FullName))
                                {
                                    var parts = Model.FullName.Trim().Split(' ');
                                    if (parts.Length >= 2)
                                        initials = parts[0][0].ToString() + parts[1][0].ToString();
                                    else
                                        initials = parts[0][0].ToString();
                                }
                                else if (!string.IsNullOrEmpty(Model.UserName))
                                {
                                    initials = Model.UserName[0].ToString().ToUpper();
                                }
                            }
                            @initials
                        </div>
                    }

                    <!-- ===== PENCIL ICON OVERLAY ===== -->
                    <div style="position: absolute; bottom: 0; right: 0; background: linear-gradient(135deg, #F195B2, #62C3E7); width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 3px solid #fff; box-shadow: 0 4px 15px rgba(241,149,178,0.3); transition: 0.3s;">
                        <i class="fas fa-pencil-alt" style="color: #fff; font-size: 14px;"></i>
                    </div>
                </div>

                <!-- Hidden File Input -->
                <form id="profilePicForm" asp-action="UpdateProfilePicture" method="post" enctype="multipart/form-data" style="display:none;">
                    @Html.AntiForgeryToken()
                    <input type="file" id="fileInput" name="profilePicture" accept="image/*" onchange="document.getElementById('profilePicForm').submit();" />
                </form>

                <h4 style="margin-top: 12px; font-weight: 700; color: #2d2d2d;">@Model.FullName</h4>
                <p style="color: #888; font-size: 0.9rem;">@Model.Email</p>
                <p style="color: #aaa; font-size: 0.8rem;"><i class="fas fa-info-circle"></i> Click on avatar to change picture</p>
            </div>

            <!-- ===== USER INFO ===== -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <label style="font-weight: 600; font-size: 0.85rem; color: #888; display: block;">Full Name</label>
                    <p style="font-weight: 500; color: #2d2d2d; margin: 0;">@Model.FullName</p>
                </div>
                <div>
                    <label style="font-weight: 600; font-size: 0.85rem; color: #888; display: block;">Email</label>
                    <p style="font-weight: 500; color: #2d2d2d; margin: 0;">@Model.Email</p>
                </div>
                <div>
                    <label style="font-weight: 600; font-size: 0.85rem; color: #888; display: block;">Phone</label>
                    <p style="font-weight: 500; color: #2d2d2d; margin: 0;">@(Model.PhoneNumber ?? "Not provided")</p>
                </div>
                <div>
                    <label style="font-weight: 600; font-size: 0.85rem; color: #888; display: block;">Address</label>
                    <p style="font-weight: 500; color: #2d2d2d; margin: 0;">@(Model.Address ?? "Not provided")</p>
                </div>
                <div>
                    <label style="font-weight: 600; font-size: 0.85rem; color: #888; display: block;">Account Type</label>
                    <p style="font-weight: 500; color: #2d2d2d; margin: 0;">
                        @if (Model.IsPaid)
                        {
                            <span style="background: #d4edda; color: #155724; padding: 2px 12px; border-radius: 50px; font-size: 0.8rem; font-weight: 600;">Premium</span>
                        }
                        else
                        {
                            <span style="background: #f8d7da; color: #721c24; padding: 2px 12px; border-radius: 50px; font-size: 0.8rem; font-weight: 600;">Free</span>
                        }
                    </p>
                </div>
                <div>
                    <label style="font-weight: 600; font-size: 0.85rem; color: #888; display: block;">Member Since</label>
                    <p style="font-weight: 500; color: #2d2d2d; margin: 0;">@Model.CreatedAt.ToString("dd MMM yyyy")</p>
                </div>
            </div>

            <!-- Divider -->
            <div style="border-top: 1px solid #f0ecee; margin: 20px 0;"></div>

            <!-- Action Buttons -->
            <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 25px;">
                <a asp-controller="Account" asp-action="EditProfile" class="btn btn-primary" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border: none; border-radius: 50px; padding: 10px 28px; font-weight: 600; text-decoration: none; color: #fff;">Edit Profile</a>
                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary" style="border-radius: 50px; padding: 10px 28px; font-weight: 600; text-decoration: none; border: 1.5px solid #ddd; color: #555;">Change Password</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 50px; padding: 10px 28px; font-weight: 600; text-decoration: none; border: 1.5px solid #ddd; color: #555;">Back to Home</a>
            </div>

            <!-- ===== ORDER HISTORY ===== -->
            <div style="border-top: 1px solid #f0ecee; padding-top: 25px;">
                <h5 style="font-weight: 700; color: #2d2d2d; margin-bottom: 15px;"><i class="fas fa-shopping-bag text-primary me-2"></i>My Order History</h5>

                @{
                    var orders = ViewBag.Orders as IEnumerable<Ice_Cream_Parlour_Eproject.Areas.Models.Order> ?? new List<Ice_Cream_Parlour_Eproject.Areas.Models.Order>();
                }

                @if (orders.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size: 0.9rem;">
                            <thead>
                                <tr class="text-muted">
                                    <th>Order #</th>
                                    <th>Date</th>
                                    <th>Products</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in orders)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@order.OrderNumber</td>
                                        <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (order.OrderItems != null && order.OrderItems.Any())
                                            {
                                                <ul class="list-unstyled mb-0" style="padding-left: 0;">
                                                    @foreach (var item in order.OrderItems)
                                                    {
                                                        <li class="small text-dark">@item.ProductName x @item.Quantity</li>
                                                    }
                                                </ul>
                                            }
                                            else if (order.Book != null)
                                            {
                                                <span class="small text-dark">Book: @order.Book.Title</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                        <td class="fw-semibold text-dark">$@order.TotalAmount.ToString("0.00")</td>
                                        <td>
                                            @if (order.OrderStatus == "Completed" || order.OrderStatus == "Delivered")
                                            {
                                                <span class="badge bg-success">@order.OrderStatus</span>
                                            }
                                            else if (order.OrderStatus == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">@order.OrderStatus</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 20px; background: #f8f9fa; border-radius: 12px; border: 1px dashed #ddd;">
                        <i class="fas fa-box-open fa-2x text-muted mb-2"></i>
                        <p class="text-muted mb-0 small">No orders placed yet. Explore our delicious ice cream products and start ordering!</p>
                        <a asp-controller="Home" asp-action="Product" class="btn btn-sm btn-link text-primary mt-2" style="font-weight: 600; text-decoration: none;">Browse Products</a>
                    </div>
                }
            </div>

        </div>
    </div>
</section>

<!-- ===== TOAST MESSAGES ===== -->
@if (TempData["Success"] != null)
{
    <div style="position: fixed; top: 20px; right: 20px; background: #28a745; color: #fff; padding: 12px 24px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); z-index: 9999;">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="position: fixed; top: 20px; right: 20px; background: #dc3545; color: #fff; padding: 12px 24px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); z-index: 9999;">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

<!-- ===== BACK TO TOP ===== -->
<a href="#" style="position: fixed; bottom: 30px; right: 30px; width: 44px; height: 44px; background: linear-gradient(135deg, #F195B2, #62C3E7); color: #fff; border: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; box-shadow: 0 6px 20px rgba(241,149,178,0.4); text-decoration: none; z-index: 999; transition:0.3s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 10px 30px rgba(241,149,178,0.5)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 20px rgba(241,149,178,0.4)';">
    <i class="fa fa-angle-double-up"></i>
</a>

<style>
    @@media (max-width: 576px) {
        .profile-grid {
            grid-template-columns: 1fr !important;
        }

        .profile-actions {
            flex-direction: column;
        }

            .profile-actions a {
                width: 100%;
                text-align: center;
            }
    }
</style>