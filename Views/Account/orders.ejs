<%- include('../partials/header') %>

<div class="bg-light py-4 border-bottom">
    <div class="container">
        <h2 class="font-playfair fw-bold mb-1">My Order History</h2>
        <p class="text-muted mb-0">View all previous orders and delivery tracking</p>
    </div>
</div>

<div class="container py-5">
    <% if (orders.length === 0) { %>
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border p-5">
            <i class="fas fa-receipt fa-4x text-muted mb-3"></i>
            <h4 class="fw-bold">No Orders Placed Yet</h4>
            <p class="text-muted mb-4">When you place an order, it will appear here with live tracking status.</p>
            <a href="/products" class="btn btn-primary rounded-pill px-4 text-white fw-bold" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">Start Shopping</a>
        </div>
    <% } else { %>
        <div class="row g-4">
            <% orders.forEach(order => { %>
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom mb-3 gap-2">
                            <div>
                                <span class="fw-bold text-primary fs-5"><%= order.orderNumber %></span>
                                <span class="text-muted small ms-2"><i class="far fa-calendar-alt me-1"></i><%= new Date(order.orderDate).toLocaleString() %></span>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <% if (order.orderStatus === 'Delivered') { %>
                                    <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i>Delivered</span>
                                <% } else if (order.orderStatus === 'Shipped') { %>
                                    <span class="badge bg-info text-dark rounded-pill px-3 py-2"><i class="fas fa-truck me-1"></i>Shipped</span>
                                <% } else if (order.orderStatus === 'Processing') { %>
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="fas fa-spinner fa-spin me-1"></i>Processing</span>
                                <% } else { %>
                                    <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="fas fa-clock me-1"></i>Pending</span>
                                <% } %>

                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2"><%= order.paymentMethod %> (<%= order.paymentStatus %>)</span>
                            </div>
                        </div>

                        <div class="row g-3 align-items-center">
                            <div class="col-md-8">
                                <h6 class="fw-bold text-muted mb-2">Order Items:</h6>
                                <ul class="list-unstyled mb-0">
                                    <% order.items.forEach(item => { %>
                                        <li class="small text-dark mb-1">
                                            <i class="fas fa-ice-cream text-primary me-2"></i>
                                            <strong><%= item.productName %></strong> x <%= item.quantity %> ($<%= item.unitPrice.toFixed(2) %> ea)
                                        </li>
                                    <% }); %>
                                </ul>
                                <% if (order.deliveryAddress) { %>
                                    <small class="text-muted d-block mt-2"><i class="fas fa-map-marker-alt me-1 text-danger"></i>Address: <%= order.deliveryAddress %></small>
                                <% } %>
                            </div>
                            <div class="col-md-4 text-md-end border-start border-md-start">
                                <small class="text-muted d-block">Total Amount Paid</small>
                                <span class="fs-3 fw-bold text-primary">$<%= order.totalAmount.toFixed(2) %></span>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
