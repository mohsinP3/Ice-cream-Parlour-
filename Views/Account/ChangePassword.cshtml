@model ChangePasswordModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Change Password - iCREAM";
}

<section class="py-5" style="background: #f8f9fa;">
    <div class="container" style="max-width: 600px;">
        <div class="card border-0 shadow-sm rounded-4 p-4" style="border: 1px solid rgba(241,149,178,0.1) !important;">
            <div class="text-center mb-4">
                <span class="badge bg-secondary text-white px-3 py-2 rounded-pill mb-2">Security</span>
                <h3 class="fw-bold text-dark">Change Password</h3>
                <p class="text-muted small">Update your password regularly to maintain high account security.</p>
            </div>

            <form asp-action="ChangePassword" method="post" class="needs-validation">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 p-2 small mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="OldPassword" class="form-label fw-semibold text-dark">
                        <i class="fas fa-lock text-primary me-2"></i>Current Password
                    </label>
                    <input asp-for="OldPassword" class="form-control form-control-lg rounded-3" style="border: 2px solid #e9ecef;" />
                    <span asp-validation-for="OldPassword" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold text-dark">
                        <i class="fas fa-key text-primary me-2"></i>New Password
                    </label>
                    <input asp-for="NewPassword" class="form-control form-control-lg rounded-3" style="border: 2px solid #e9ecef;" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark">
                        <i class="fas fa-check-double text-primary me-2"></i>Confirm New Password
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg rounded-3" style="border: 2px solid #e9ecef;" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill" style="box-shadow: 0 4px 15px rgba(241,149,178,0.3);">
                        <i class="fas fa-key me-2"></i>Change Password
                    </button>
                    <a asp-action="Profile" class="btn btn-outline-secondary btn-lg w-100 rounded-pill">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
