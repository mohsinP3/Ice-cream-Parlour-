<%- include('../partials/header') %>

<div class="bg-light py-4 border-bottom">
    <div class="container">
        <h2 class="font-playfair fw-bold mb-1">My Account &amp; Dashboard</h2>
        <p class="text-muted mb-0">Manage profile details, membership status, and orders</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <!-- Profile Card -->
        <div class="col-lg-4">
            <div class="bg-white rounded-4 shadow-sm border p-4 text-center">
                <div class="position-relative d-inline-block mb-3">
                    <% if (currentUser.profilePicture) { %>
                        <img src="<%= currentUser.profilePicture %>" class="rounded-circle shadow" style="width: 120px; height: 120px; object-fit: cover;" alt="Profile Picture" />
                    <% } else { %>
                        <div class="rounded-circle shadow d-flex align-items-center justify-content-center text-white fs-1 fw-bold mx-auto" style="width: 120px; height: 120px; background: linear-gradient(135deg, #F195B2, #62C3E7);">
                            <%= (currentUser.fullName || 'U').charAt(0).toUpperCase() %>
                        </div>
                    <% } %>
                </div>

                <h4 class="fw-bold mb-1"><%= currentUser.fullName %></h4>
                <p class="text-muted small mb-3"><%= currentUser.email %></p>

                <% if (currentUser.isPaid) { %>
                    <div class="mb-3">
                        <span class="badge bg-success rounded-pill px-3 py-2 d-inline-block mb-2"><i class="fas fa-crown me-1"></i>Active VIP Member</span>
                        <form action="/account/membership-toggle" method="POST" class="d-block">
                            <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0">Cancel VIP Subscription</button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="mb-3">
                        <span class="badge bg-secondary rounded-pill px-3 py-2 d-inline-block mb-2">Free Tier Member</span>
                        <form action="/account/membership-toggle" method="POST" class="d-block">
                            <button type="submit" class="btn btn-sm btn-warning text-dark rounded-pill px-3 fw-bold shadow-sm"><i class="fas fa-crown me-1"></i> Upgrade to VIP ($15/mo)</button>
                        </form>
                    </div>
                <% } %>

                <!-- Profile Picture Form -->
                <form action="/account/profile-picture" method="POST" enctype="multipart/form-data" class="mt-3 pt-3 border-top">
                    <label class="form-label small fw-bold text-muted d-block text-start mb-2">Update Avatar</label>
                    <input type="file" name="profilePicture" accept="image/*" class="form-control form-control-sm mb-2" required />
                    <button type="submit" class="btn btn-sm btn-outline-primary w-100 rounded-pill">Upload Picture</button>
                </form>
            </div>
        </div>

        <!-- Details & Actions -->
        <div class="col-lg-8">
            <div class="bg-white rounded-4 shadow-sm border p-4 p-md-5 mb-4">
                <h4 class="fw-bold mb-4 text-dark border-bottom pb-3"><i class="fas fa-id-card text-primary me-2"></i>Personal Details</h4>
                <form action="/account/profile-update" method="POST">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Full Name</label>
                            <input type="text" name="fullName" class="form-control rounded-3" value="<%= currentUser.fullName %>" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email Address</label>
                            <input type="email" class="form-control rounded-3" value="<%= currentUser.email %>" disabled />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Delivery Address</label>
                            <textarea name="address" class="form-control rounded-3" rows="3"><%= currentUser.address || '' %></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 mt-4 text-white fw-bold" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border:none;">
                        Save Changes
                    </button>
                </form>
            </div>

            <!-- Dashboard Actions Grid -->
            <div class="row g-3">
                <div class="col-md-6">
                    <a href="/orders/history" class="card border-0 shadow-sm rounded-4 p-4 text-decoration-none h-100 text-dark">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-3 text-white me-3" style="background: #62C3E7;">
                                <i class="fas fa-receipt fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">My Orders</h5>
                                <p class="text-muted small mb-0">Track order statuses &amp; purchase history</p>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-6">
                    <a href="/recipes" class="card border-0 shadow-sm rounded-4 p-4 text-decoration-none h-100 text-dark">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-3 text-white me-3" style="background: #F195B2;">
                                <i class="fas fa-utensils fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Recipe Guides</h5>
                                <p class="text-muted small mb-0">Access 20+ artisan ice cream recipes</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
