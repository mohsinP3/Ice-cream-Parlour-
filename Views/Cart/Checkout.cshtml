@model OrderCheckoutViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Checkout - iCREAM";
    var cart = ViewBag.Cart as IEnumerable<CartItem> ?? new List<CartItem>();
}

<!-- Header Start -->
<div class="jumbotron jumbotron-fluid page-header" style="margin-bottom: 50px; background-image:url('/img/header.jpg'); background-size: cover; background-position: center;">
    <div class="container text-center py-5">
        <h1 class="text-white display-3 mt-lg-5">Secure Checkout</h1>
        <div class="d-inline-flex align-items-center text-white">
            <p class="m-0"><a class="text-white" asp-action="Index" asp-controller="Home">Home</a></p>
            <i class="fa fa-circle px-3"></i>
            <p class="m-0">Checkout</p>
        </div>
    </div>
</div>
<!-- Header End -->

<div class="container py-5">
    <div class="row g-5">
        <!-- Billing / Shipping Details -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-bold text-dark mb-4"><i class="fas fa-shipping-fast text-primary me-2"></i>Delivery Details</h4>

                <form asp-action="Checkout" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 p-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label asp-for="Name" class="form-label fw-semibold text-dark">Full Name</label>
                                <input asp-for="Name" class="form-control rounded-3" style="border: 2px solid #e9ecef;" placeholder="Enter recipient full name" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Email" class="form-label fw-semibold text-dark">Email Address</label>
                                <input asp-for="Email" class="form-control rounded-3" style="border: 2px solid #e9ecef;" placeholder="e.g. user@icream.com" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Phone" class="form-label fw-semibold text-dark">Phone Number</label>
                                <input asp-for="Phone" class="form-control rounded-3" style="border: 2px solid #e9ecef;" placeholder="e.g. +92 300 1234567" required />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label asp-for="DeliveryAddress" class="form-label fw-semibold text-dark">Complete Delivery Address</label>
                                <textarea asp-for="DeliveryAddress" rows="3" class="form-control rounded-3" style="border: 2px solid #e9ecef;" placeholder="Street name, Sector, Area, City, etc." required></textarea>
                                <span asp-validation-for="DeliveryAddress" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label asp-for="Notes" class="form-label fw-semibold text-dark">Special Instructions / Notes</label>
                                <textarea asp-for="Notes" rows="2" class="form-control rounded-3" style="border: 2px solid #e9ecef;" placeholder="e.g. Call before delivery, ring doorbell etc."></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-dark d-block mb-2">Payment Method</label>
                            <div class="form-check form-check-inline bg-light p-3 rounded-3 me-3 mb-2" style="border: 1px solid #e9ecef; cursor: pointer;">
                                <input class="form-check-input ms-1" type="radio" asp-for="PaymentMethod" value="Cash on Delivery" checked id="codPayment">
                                <label class="form-check-label ms-2 fw-semibold text-dark" for="codPayment">
                                    <i class="fas fa-hand-holding-usd text-primary me-2"></i>Cash on Delivery
                                </label>
                            </div>
                            <div class="form-check form-check-inline bg-light p-3 rounded-3 mb-2" style="border: 1px solid #e9ecef; cursor: pointer;">
                                <input class="form-check-input ms-1" type="radio" asp-for="PaymentMethod" value="Online Card" id="onlineCardPayment">
                                <label class="form-check-label ms-2 fw-semibold text-dark" for="onlineCardPayment">
                                    <i class="fas fa-credit-card text-secondary me-2"></i>Debit/Credit Card
                                </label>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill mt-4" style="box-shadow: 0 4px 15px rgba(241,149,178,0.3);">
                        <i class="fas fa-lock me-2"></i>Place Secure Order
                    </button>
                </form>
            </div>
        </div>

        <!-- Cart Summary Box -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="border: 1px solid rgba(241,149,178,0.1) !important;">
                <h5 class="fw-bold text-dark mb-4">Your Order Summary</h5>

                <div class="cart-summary-items mb-3" style="max-height: 280px; overflow-y: auto;">
                    @foreach (var item in cart)
                    {
                        <div class="d-flex align-items-center mb-3">
                            <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/img/product-1.jpg" : item.ImagePath)" alt="@item.ProductName" class="rounded-3 me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-0 text-dark small">@item.ProductName</h6>
                                <span class="text-muted small">@item.Quantity x $@item.UnitPrice.ToString("0.00")</span>
                            </div>
                            <span class="fw-bold text-dark small">$@item.LineTotal.ToString("0.00")</span>
                        </div>
                    }
                </div>

                <hr style="border-color: #f8f9fa;" />

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Subtotal</span>
                    <span class="fw-semibold text-dark small">$@cart.Sum(i => i.LineTotal).ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Delivery Charges</span>
                    <span class="text-success fw-semibold small">FREE</span>
                </div>

                <hr class="my-3" style="border-color: #f8f9fa;" />

                <div class="d-flex justify-content-between">
                    <span class="fw-bold text-dark">Total Amount</span>
                    <span class="fw-bold fs-4 text-primary">$@cart.Sum(i => i.LineTotal).ToString("0.00")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
