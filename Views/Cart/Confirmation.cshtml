@model Ice_Cream_Parlour_Eproject.Areas.Models.Order
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Order Confirmed - iCREAM";
}

<div class="container py-5">
    <div class="text-center py-5">
        <div class="bg-success rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px; box-shadow: 0 4px 15px rgba(40,167,69,0.2);">
            <i class="fas fa-check fa-3x text-white"></i>
        </div>
        <h2 class="fw-bold text-dark mb-2">Thank You For Your Order!</h2>
        <p class="text-success fw-semibold mb-4">Your order has been received and is being prepared with love.</p>

        <div class="card border-0 shadow-sm rounded-4 p-4 mx-auto mb-4 text-start" style="max-width: 650px; border: 1px solid rgba(0,0,0,0.05) !important;">
            <h5 class="fw-bold text-dark mb-3">Order Details</h5>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <span class="text-muted d-block small">Order Number</span>
                    <span class="fw-bold text-primary">@Model.OrderNumber</span>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">Order Date</span>
                    <span class="fw-semibold text-dark">@Model.OrderDate.ToString("dd MMM yyyy hh:mm tt")</span>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">Customer Name</span>
                    <span class="fw-semibold text-dark">@Model.CustomerName</span>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">Email Address</span>
                    <span class="fw-semibold text-dark">@Model.CustomerEmail</span>
                </div>
                <div class="col-md-12">
                    <span class="text-muted d-block small">Delivery Address</span>
                    <span class="fw-semibold text-dark">@Model.DeliveryAddress</span>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">Payment Method</span>
                    <span class="fw-semibold text-dark">@Model.PaymentMethod</span>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">Payment Status</span>
                    <span class="badge bg-warning text-dark">@Model.PaymentStatus</span>
                </div>
            </div>

            <hr style="border-color: #f8f9fa;" />

            <h6 class="fw-bold text-dark mb-3">Products Purchased</h6>
            @foreach (var item in Model.OrderItems)
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-dark small">@item.ProductName <strong class="text-muted">x @item.Quantity</strong></span>
                    <span class="fw-semibold text-dark small">$@item.LineTotal.ToString("0.00")</span>
                </div>
            }

            <hr style="border-color: #f8f9fa;" />

            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark">Total Paid</span>
                <span class="fw-bold fs-4 text-primary">$@Model.TotalAmount.ToString("0.00")</span>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Product" class="btn btn-primary btn-lg rounded-pill px-4" style="box-shadow: 0 4px 15px rgba(241,149,178,0.3);">
                Order More Flavors
            </a>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                View My Orders
            </a>
        </div>
    </div>
</div>
